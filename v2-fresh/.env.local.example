# Atlantico proxy (same as the parent project's working endpoint)
ATLANTICO_BASE_URL=https://api.tenerife-activity.com

# Atlantico collaborator ID (receives commission)
ATLANTICO_USER_ID=3645

# Timeouts and caching
ATLANTICO_TIMEOUT_MS=10000
ATLANTICO_REVALIDATE_SECONDS=300

# Optional: override image CDN (fallback is api.atlanticoexcursiones.com/images)
# NEXT_PUBLIC_ATLANTICO_IMAGES_BASE_URL=

# Supabase (optional — enables testimonials-curated module)
# Leave unset to keep the module dormant. When set, the module fetches
# reviews from the `reviews` table over PostgREST (RLS-gated to published=true).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Weather-live provider (optional — shell route exists but returns 503 until set)
# WEATHER_LIVE_PROVIDER=aemet
# AEMET_API_KEY=
# OPENWEATHER_API_KEY=
