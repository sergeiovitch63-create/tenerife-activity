# Atlantico API Configuration
# Copy this file to .env.local and fill in the values

# Base URL for Atlantico API proxy (required)
# Example: https://api.tenerife-activity.com
ATLANTICO_BASE_URL=

# Request timeout in milliseconds (optional, default: 10000)
ATLANTICO_TIMEOUT_MS=10000

# Cache revalidation time in seconds (optional, default: 300)
# This controls how long Next.js caches API responses
ATLANTICO_REVALIDATE_SECONDS=300

# API token/authentication key (optional, if required by Atlantico)
# ATLANTICO_TOKEN=
# Atlantico User ID (required for booking confirm/payment)
ATLANTICO_USER_ID=12056

# Neon (affiliation, etc.) — Vercel sets POSTGRES_URL when DB is connected with prefix POSTGRES
# POSTGRES_URL=
# DATABASE_URL=   # alternative name some tools use
